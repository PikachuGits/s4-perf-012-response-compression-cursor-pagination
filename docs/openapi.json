  "info": {
    "description": "会员空间平台性能工单的独立参考实现。列表接口默认使用签名游标分页；`pagination=offset` 仅为前后对比保留，已标记 deprecated。大于 1 KB 的 JSON 响应按 `Accept-Encoding` 协商 br/gzip。",
    "title": "S4-PERF-012 · 接口响应压缩与游标分页参考实现",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/audit-logs": {
      "get": {
        "description": "默认 pagination=cursor：首屏不传 cursor，后续把上一页的 next_cursor 原样回传。游标绑定 action/actor_id/outcome 筛选条件，跨条件复用返回 CURSOR_SCOPE_MISMATCH。",
        "operationId": "list_audit_logs_api_v1_audit_logs_get",
        "parameters": [
          {
            "description": "每页记录数，1–200，默认 50。游标分页同样适用。",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "每页记录数，1–200，默认 50。游标分页同样适用。",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "上一页返回的 next_cursor。首屏不传；必须原样回传，游标绑定了租户与筛选条件，跨条件复用会返回 CURSOR_SCOPE_MISMATCH。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "上一页返回的 next_cursor。首屏不传；必须原样回传，游标绑定了租户与筛选条件，跨条件复用会返回 CURSOR_SCOPE_MISMATCH。",
              "examples": [
                "eyJ2IjoxLCJzIjoi...0Y2Fi"
              ],
              "title": "Cursor"
            }
          },
          {
            "description": "分页方式。默认 cursor（keyset，推荐）；offset 已废弃，仅用于灰度期与性能对比，后续将移除。",
            "in": "query",
            "name": "pagination",
            "required": false,
            "schema": {
              "default": "cursor",
              "description": "分页方式。默认 cursor（keyset，推荐）；offset 已废弃，仅用于灰度期与性能对比，后续将移除。",
              "enum": [
                "cursor",
                "offset"
              ],
              "title": "Pagination",
              "type": "string"
            }
          },
          {
            "deprecated": true,
            "description": "仅 pagination=offset 时生效的旧偏移量；已废弃，新客户端不要使用。",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "deprecated": true,
              "description": "仅 pagination=offset 时生效的旧偏移量；已废弃，新客户端不要使用。",
              "maximum": 10000000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 模式生效：是否额外执行 COUNT 返回 total（会增加响应时间）。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "default": false,
              "description": "仅 offset 模式生效：是否额外执行 COUNT 返回 total（会增加响应时间）。",
              "title": "With Total",
              "type": "boolean"
            }
          },
          {
            "description": "按操作类型筛选",
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 60,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "按操作类型筛选",
              "title": "Action"
            }
          },
          {
            "description": "按操作者 ID 筛选",
            "in": "query",
            "name": "actor_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "按操作者 ID 筛选",
              "title": "Actor Id"
            }
          },
          {
            "description": "按结果筛选",
            "in": "query",
            "name": "outcome",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 20,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "按结果筛选",
              "title": "Outcome"
            }
          },
          {
            "in": "header",
            "name": "X-Org-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Org-Id"
            }
          },
          {
            "in": "header",
            "name": "X-Site-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Site-Id"
            }
          },
          {
            "in": "header",
            "name": "X-User-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLogPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "审计查询列表（游标分页）",
        "tags": [
          "audit"
        ]
      }
    },
